<Page x:Class="AdminSetupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Setup EDOM"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="{StaticResource BodyFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SubtleBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Periode Aktif"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkSecondaryBrush}"/>
                        <TextBlock x:Name="txtNamaPeriodeAktif"
                                   Text="-"
                                   FontFamily="{StaticResource DisplayFontFamily}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Rectangle Width="1" Fill="{StaticResource BorderLightBrush}" Margin="0,2,28,2"/>

                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="Rentang Jadwal"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkSecondaryBrush}"/>
                        <TextBlock x:Name="txtRentangAktif"
                                   Text="-"
                                   FontFamily="{StaticResource NumericFontFamily}"
                                   Typography.NumeralAlignment="Tabular"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkPrimaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Rectangle Width="1" Fill="{StaticResource BorderLightBrush}" Margin="0,2,28,2"/>

                    <StackPanel>
                        <TextBlock Text="Butir Instrumen"
                                   FontSize="11.5"
                                   Foreground="{StaticResource InkSecondaryBrush}"/>
                        <TextBlock x:Name="txtJumlahSoalRingkas"
                                   Text="0 pertanyaan aktif"
                                   FontFamily="{StaticResource NumericFontFamily}"
                                   Typography.NumeralAlignment="Tabular"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkPrimaryBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="dotStatusBanner"
                             Width="8"
                             Height="8"
                             Fill="#64748B"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="txtStatusBanner"
                               Text="Semua sesi ditutup"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#64748B"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="garisTabPeriode"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,0,0,2"
                        Margin="0,0,24,0">
                    <Button x:Name="btnTabPeriode"
                            Content="Sesi Periode"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,6,2,10"
                            Cursor="Hand"
                            Click="btnTabPeriode_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <Border x:Name="garisTabSoal"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2">
                    <Button x:Name="btnTabSoal"
                            Content="Instrumen Pertanyaan"
                            FontSize="13.5"
                            FontWeight="Normal"
                            Foreground="{StaticResource InkSecondaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="2,6,2,10"
                            Cursor="Hand"
                            Click="btnTabSoal_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </StackPanel>
        </Border>

        <Grid x:Name="panelPeriode" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InputFrameBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{StaticResource InkSecondaryBrush}"
                              Data="M 11,4 C 7.13,4 4,7.13 4,11 C 4,14.87 7.13,18 11,18 C 12.66,18 14.18,17.42 15.38,16.45 L 20,21 L 21.4,19.6 L 16.8,15 C 17.56,13.85 18,12.48 18,11 C 18,7.13 14.87,4 11,4 Z M 11,6 C 13.76,6 16,8.24 16,11 C 16,13.76 13.76,16 11,16 C 8.24,16 6,13.76 6,11 C 6,8.24 8.24,6 11,6 Z"/>

                        <TextBox x:Name="txtCariPeriode"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,12,0"
                                 FontSize="13"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TextChanged="txtCariPeriode_TextChanged"/>

                        <TextBlock x:Name="txtPlaceholderPeriode"
                                   Grid.Column="1"
                                   Text="Cari nama periode, tahun ajaran, atau semester..."
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="btnTambahPeriode"
                            Content="Tambah Periode"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnTambahPeriode_Click"/>

                    <Button x:Name="btnEditPeriode"
                            Content="Edit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnEditPeriode_Click"/>

                    <Button x:Name="btnToggleSesi"
                            Content="Buka Sesi"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            MinWidth="96"
                            Click="btnToggleSesi_Click"/>

                    <Button x:Name="btnHapusPeriode"
                            Content="Hapus"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnHapusPeriode_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgPeriode"
                      Grid.Row="1"
                      Style="{StaticResource CleanDataGridStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      SelectionChanged="dgPeriode_SelectionChanged"
                      MouseDoubleClick="dgPeriode_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama Periode" Binding="{Binding NamaPeriode}" Width="1.3*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Tahun Ajaran" Binding="{Binding TahunAjaranTeks}" Width="0.85*" ElementStyle="{StaticResource TabularNumericSecondaryStyle}"/>
                    <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="0.7*"/>
                    <DataGridTextColumn Header="Tanggal Mulai" Binding="{Binding TanggalMulaiTeks}" Width="0.9*" ElementStyle="{StaticResource TabularNumericSecondaryStyle}"/>
                    <DataGridTextColumn Header="Tanggal Selesai" Binding="{Binding TanggalSelesaiTeks}" Width="0.9*" ElementStyle="{StaticResource TabularNumericSecondaryStyle}"/>
                    <DataGridTemplateColumn Header="Status Sesi" Width="1.25*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="{Binding WarnaStatus}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding StatusTeks}" Foreground="{Binding WarnaStatus}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtRingkasanPeriode"
                           Grid.Column="0"
                           Text="Menampilkan 0 periode"
                           FontSize="12"
                           Foreground="{StaticResource InkSecondaryBrush}"/>

                <TextBlock Grid.Column="1"
                           Text="Klik dua kali baris periode untuk mengedit jadwal"
                           FontSize="12"
                           Foreground="{StaticResource InkSecondaryBrush}"/>
            </Grid>
        </Grid>

        <Grid x:Name="panelSoal" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InputFrameBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Width="14"
                              Height="14"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{StaticResource InkSecondaryBrush}"
                              Data="M 11,4 C 7.13,4 4,7.13 4,11 C 4,14.87 7.13,18 11,18 C 12.66,18 14.18,17.42 15.38,16.45 L 20,21 L 21.4,19.6 L 16.8,15 C 17.56,13.85 18,12.48 18,11 C 18,7.13 14.87,4 11,4 Z M 11,6 C 13.76,6 16,8.24 16,11 C 16,13.76 13.76,16 11,16 C 8.24,16 6,13.76 6,11 C 6,8.24 8.24,6 11,6 Z"/>

                        <TextBox x:Name="txtCariSoal"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,12,0"
                                 FontSize="13"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TextChanged="txtCariSoal_TextChanged"/>

                        <TextBlock x:Name="txtPlaceholderSoal"
                                   Grid.Column="1"
                                   Text="Cari butir pertanyaan atau kompetensi..."
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="cmbFilterKategori"
                          Grid.Column="1"
                          Style="{StaticResource CleanComboBoxStyle}"
                          Height="40"
                          Margin="10,0,0,0"
                          SelectionChanged="cmbFilterKategori_SelectionChanged">
                    <ComboBoxItem Content="Semua Kompetensi" Tag="semua" IsSelected="True"/>
                    <ComboBoxItem Content="Kompetensi Pedagogik" Tag="pedagogik"/>
                    <ComboBoxItem Content="Kompetensi Profesional" Tag="profesional"/>
                    <ComboBoxItem Content="Kompetensi Kepribadian" Tag="kepribadian"/>
                    <ComboBoxItem Content="Kompetensi Sosial" Tag="sosial"/>
                </ComboBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="btnTambahSoal"
                            Content="Tambah Soal"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnTambahSoal_Click"/>

                    <Button x:Name="btnEditSoal"
                            Content="Edit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnEditSoal_Click"/>

                    <Button x:Name="btnHapusSoal"
                            Content="Hapus"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnHapusSoal_Click"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="dgSoal"
                      Grid.Row="1"
                      Style="{StaticResource CleanDataGridStyle}"
                      RowHeight="NaN"
                      MinRowHeight="46"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      MouseDoubleClick="dgSoal_MouseDoubleClick">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="0,1,0,1"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="14" Background="{StaticResource AccentBrush}" CornerRadius="1" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkPrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat={}{0} butir}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkSecondaryBrush}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="No" Binding="{Binding Nomor}" Width="56" ElementStyle="{StaticResource TabularNumericPrimaryStyle}"/>
                    <DataGridTemplateColumn Header="Butir Pertanyaan" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Pertanyaan}"
                                           TextWrapping="Wrap"
                                           Margin="0,10"
                                           LineHeight="19"
                                           Foreground="{StaticResource InkPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kompetensi" Binding="{Binding LabelKategori}" Width="185"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtRingkasanSoal"
                           Grid.Column="0"
                           Text="Menampilkan 0 dari 0 butir pertanyaan aktif"
                           FontSize="12"
                           Foreground="{StaticResource InkSecondaryBrush}"/>

                <TextBlock Grid.Column="1"
                           Text="Klik dua kali baris pertanyaan untuk mengedit"
                           FontSize="12"
                           Foreground="{StaticResource InkSecondaryBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
