<Page x:Class="AdminUserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Daftar Dosen"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="{StaticResource BodyFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="145"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource InputFrameBorderStyle}" Height="38">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Data="M 11,4 C 7.13,4 4,7.13 4,11 C 4,14.87 7.13,18 11,18 C 12.66,18 14.18,17.42 15.38,16.45 L 20,21 L 21.4,19.6 L 16.8,15 C 17.56,13.85 18,12.48 18,11 C 18,7.13 14.87,4 11,4 Z M 11,6 C 13.76,6 16,8.24 16,11 C 16,13.76 13.76,16 11,16 C 8.24,16 6,13.76 6,11 C 6,8.24 8.24,6 11,6 Z"
                          Fill="{StaticResource InkSecondaryBrush}"
                          Width="15"
                          Height="15"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>

                    <Grid Grid.Column="1">
                        <TextBlock x:Name="lblPlaceholderCari"
                                   Text="Cari NIP atau nama dosen..."
                                   Foreground="{StaticResource InkSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="2,0,12,0"
                                   IsHitTestVisible="False"/>

                        <TextBox x:Name="txtCari"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="2,0,12,0"
                                 FontSize="13"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TextChanged="txtCari_TextChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <ComboBox x:Name="cmbFilterRole"
                      Grid.Column="2"
                      Style="{StaticResource CleanComboBoxStyle}"
                      SelectionChanged="cmbFilterRole_SelectionChanged">
                <ComboBoxItem Content="Dosen" Tag="dosen" IsSelected="True"/>
                <ComboBoxItem Content="Admin Jurusan" Tag="admin"/>
                <ComboBoxItem Content="Semua Staf" Tag="staf"/>
            </ComboBox>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnTambah"
                        Content="Tambah Dosen"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="btnTambah_Click"/>

                <Button x:Name="btnDetailDosen"
                        Content="Detail Evaluasi"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Click="btnDetailDosen_Click"/>

                <Button x:Name="btnEdit"
                        Content="Edit"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Click="btnEdit_Click"/>

                <Button x:Name="btnResetPassword"
                        Content="Reset Sandi"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="8,0,0,0"
                        Click="btnResetPassword_Click"/>

                <Button x:Name="btnHapus"
                        Content="Nonaktifkan"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Margin="8,0,0,0"
                        Click="btnHapus_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="dgUser"
                          Style="{StaticResource CleanDataGridStyle}"
                          MouseDoubleClick="dgUser_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NIP / Username" Binding="{Binding username}" Width="172" ElementStyle="{StaticResource TabularNumericPrimaryStyle}"/>

                        <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding nama}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Peran" Binding="{Binding role_label}" Width="0.95*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Kelas Diampu" Binding="{Binding pengampu_label}" Width="1.15*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Status" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding status_color}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding status_label}" Foreground="{Binding status_color}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtKosongUser"
                           Text="Data dosen tidak ditemukan."
                           Foreground="{StaticResource InkSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="2,10,0,0">
            <TextBlock x:Name="txtJumlahUser" DockPanel.Dock="Left" Text="" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
            <TextBlock DockPanel.Dock="Right" Text="Klik dua kali baris dosen untuk lihat rekap &amp; daftar kelas yang diampu" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</Page>
