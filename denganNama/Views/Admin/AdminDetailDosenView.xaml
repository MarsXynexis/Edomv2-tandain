<Page x:Class="AdminDetailDosenView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Detail Evaluasi Dosen"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnKembali"
                    Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="btnKembali_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 15,18 L 9,12 L 15,6"
                          Stroke="{StaticResource InkPrimaryBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Kembali" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                <TextBlock x:Name="txtNamaDosen" Text="-" FontSize="15" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtNipDosen" Text="-" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <ComboBox x:Name="cmbPeriode"
                      Grid.Column="2"
                      Style="{StaticResource CleanComboBoxStyle}"
                      SelectionChanged="cmbPeriode_SelectionChanged"/>

            <ComboBox x:Name="cmbKelas"
                      Grid.Column="4"
                      Style="{StaticResource CleanComboBoxStyle}"
                      SelectionChanged="cmbKelas_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SubtleBgBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="20,0">
                    <TextBlock Text="Skor Akhir Fuzzy" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="txtSkorAkhir" Text="-" FontSize="22" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,2,0,0">
                            <Ellipse x:Name="indikatorPredikat" Width="7" Height="7" Fill="{StaticResource InkSecondaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtPredikatKeseluruhan" Text="Belum dinilai" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource BorderLightBrush}"/>

                <StackPanel Grid.Column="2" Margin="18,0">
                    <TextBlock Text="Pedagogik" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="txtSkorPed" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{StaticResource BorderLightBrush}"/>

                <StackPanel Grid.Column="4" Margin="18,0">
                    <TextBlock Text="Profesional" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="txtSkorProf" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{StaticResource BorderLightBrush}"/>

                <StackPanel Grid.Column="6" Margin="18,0">
                    <TextBlock Text="Kepribadian" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="txtSkorKep" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="7" Fill="{StaticResource BorderLightBrush}"/>

                <StackPanel Grid.Column="8" Margin="18,0">
                    <TextBlock Text="Sosial" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}"/>
                    <TextBlock x:Name="txtSkorSos" Text="-" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Catatan Evaluasi:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,8,0"/>
                <TextBlock x:Name="txtRekomendasi" Text="-" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBgBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="dgKelasDosen"
                          Style="{StaticResource CleanDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding matkul_label}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Kelas" Binding="{Binding kelas_label}" Width="0.85*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SKS" Binding="{Binding sks}" Width="55"/>

                        <DataGridTextColumn Header="Responden" Binding="{Binding responden_label}" Width="0.9*"/>

                        <DataGridTextColumn Header="Ped." Binding="{Binding ped}" Width="65"/>
                        <DataGridTextColumn Header="Prof." Binding="{Binding prof}" Width="65"/>
                        <DataGridTextColumn Header="Kep." Binding="{Binding kep}" Width="65"/>
                        <DataGridTextColumn Header="Sos." Binding="{Binding sos}" Width="65"/>

                        <DataGridTextColumn Header="Skor" Binding="{Binding skor_akhir}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Predikat" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{Binding predikat_color}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding predikat_label}" Foreground="{Binding predikat_color}" FontWeight="SemiBold" FontSize="12.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="txtKosongDetailDosen"
                           Text="Belum ada mata kuliah atau kelas yang diampu dosen ini pada periode terpilih."
                           Foreground="{StaticResource InkSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Page>
