<Window x:Class="UserFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Pengguna"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBgBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="txtJudulForm"
                       Text="Tambah Akun"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkPrimaryBrush}"/>
            <TextBlock Text="Isi identitas akun pengguna sistem EDOM."
                       FontSize="12.5"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="NIM / NIP / Username" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <TextBox x:Name="txtUsername"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         Foreground="{StaticResource InkPrimaryBrush}"
                         TabIndex="0"/>
            </Border>

            <TextBlock Text="Nama Lengkap" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <TextBox x:Name="txtNama"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         Foreground="{StaticResource InkPrimaryBrush}"
                         TabIndex="1"/>
            </Border>

            <TextBlock Text="Peran" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <ComboBox x:Name="cmbRole"
                      Style="{StaticResource CleanComboBoxStyle}"
                      Height="40"
                      Margin="0,0,0,14"
                      TabIndex="2"
                      SelectionChanged="cmbRole_SelectionChanged">
                <ComboBoxItem Content="Mahasiswa" Tag="mahasiswa"/>
                <ComboBoxItem Content="Dosen" Tag="dosen"/>
                <ComboBoxItem Content="Admin Jurusan" Tag="admin"/>
            </ComboBox>

            <StackPanel x:Name="panelKelas" Visibility="Collapsed" Margin="0,0,0,14">
                <TextBlock Text="Kelas Rombel" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                <ComboBox x:Name="cmbKelas"
                          Style="{StaticResource CleanComboBoxStyle}"
                          Height="40"
                          DisplayMemberPath="Teks"
                          SelectedValuePath="Id"
                          TabIndex="3"/>
            </StackPanel>

            <TextBlock Text="Kata Sandi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,6">
                <PasswordBox x:Name="txtPassword"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             FontSize="13"
                             Foreground="{StaticResource InkPrimaryBrush}"
                             TabIndex="4"/>
            </Border>
            <TextBlock x:Name="txtHintPassword"
                       Text="Minimal 6 karakter."
                       FontSize="11.5"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnBatal"
                    Content="Batal"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90"
                    IsCancel="True"
                    TabIndex="6"
                    Click="btnBatal_Click"/>

            <Button x:Name="btnSimpan"
                    Content="Simpan"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="104"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    TabIndex="5"
                    Click="btnSimpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
