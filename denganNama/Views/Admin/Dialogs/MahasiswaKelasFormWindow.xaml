<Window x:Class="MahasiswaKelasFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mahasiswa Kelas"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBgBrush}"
        FontFamily="{StaticResource BodyFontFamily}">

    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="txtJudulForm"
                       Text="Tambah Mahasiswa ke Kelas"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkPrimaryBrush}"/>
            <TextBlock x:Name="txtSubJudulForm"
                       Text="Jika NIM sudah terdaftar, akun langsung dipindahkan ke kelas ini."
                       FontSize="12.5"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="NIM" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <TextBox x:Name="txtNim"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         Foreground="{StaticResource InkPrimaryBrush}"
                         TabIndex="0"/>
            </Border>

            <TextBlock Text="Nama Lengkap" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <TextBox x:Name="txtNama"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         Foreground="{StaticResource InkPrimaryBrush}"
                         TabIndex="1"/>
            </Border>

            <StackPanel x:Name="panelPassword">
                <TextBlock Text="Kata Sandi Awal" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,6">
                    <PasswordBox x:Name="txtPassword"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FontSize="13"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TabIndex="2"/>
                </Border>
                <TextBlock Text="Kosongkan untuk pakai sandi standar: mhs"
                           FontSize="11.5"
                           Foreground="{StaticResource InkSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnBatal"
                    Content="Batal"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90"
                    IsCancel="True"
                    TabIndex="4"
                    Click="btnBatal_Click"/>

            <Button x:Name="btnSimpan"
                    Content="Simpan"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="104"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    TabIndex="3"
                    Click="btnSimpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
