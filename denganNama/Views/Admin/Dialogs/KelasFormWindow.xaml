<Window x:Class="KelasFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Kelas"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBgBrush}"
        FontFamily="{StaticResource BodyFontFamily}">

    <Grid Margin="24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="txtJudulForm"
                       Text="Tambah Kelas"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="19"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkPrimaryBrush}"/>
            <TextBlock Text="Isi program studi, angkatan, dan rombongan belajar."
                       FontSize="12.5"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Program Studi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
            <Border x:Name="borderProdi" Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBlock x:Name="lblPlaceholderProdi"
                                   Text="D4 Teknik Informatika"
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   Margin="12,0"
                                   IsHitTestVisible="False"/>

                        <TextBox x:Name="txtProdi"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FontSize="13"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TabIndex="0"
                                 TextChanged="txtProdi_TextChanged"/>
                    </Grid>

                    <ToggleButton x:Name="btnPilihProdi"
                                  Grid.Column="1"
                                  Width="34"
                                  Focusable="False"
                                  Cursor="Hand"
                                  Visibility="Collapsed"
                                  ToolTip="Pilih program studi tersimpan"
                                  PreviewMouseLeftButtonDown="btnPilihProdi_PreviewMouseLeftButtonDown">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="DropBg" Background="Transparent" CornerRadius="0,5,5,0">
                                    <Path Data="M 6,9 L 12,15 L 18,9"
                                          Stroke="{StaticResource InkSecondaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="11"
                                          Height="11"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DropBg" Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Popup x:Name="popupProdi"
                           PlacementTarget="{Binding ElementName=borderProdi}"
                           Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=btnPilihProdi, Mode=TwoWay}"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource SurfaceBgBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,4,0,4"
                                Padding="4"
                                MinWidth="{Binding ActualWidth, ElementName=borderProdi}"
                                MaxHeight="180">
                            <ListBox x:Name="lstProdiMaster"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="{StaticResource BodyFontFamily}"
                                     FontSize="13"
                                     SelectionChanged="lstProdiMaster_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBg" Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Angkatan" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrameBorderStyle}">
                        <TextBox x:Name="txtAngkatan"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FontSize="13"
                                 MaxLength="4"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TabIndex="1"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Rombel" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrameBorderStyle}">
                        <TextBox x:Name="txtRombel"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="12,0"
                                 FontSize="13"
                                 MaxLength="2"
                                 Foreground="{StaticResource InkPrimaryBrush}"
                                 TabIndex="2"/>
                    </Border>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="chkAktif"
                      Content="Status kelas aktif"
                      IsChecked="True"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="{StaticResource InkPrimaryBrush}"
                      TabIndex="3"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnBatal"
                    Content="Batal"
                    Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="90"
                    IsCancel="True"
                    TabIndex="5"
                    Click="btnBatal_Click"/>

            <Button x:Name="btnSimpan"
                    Content="Simpan"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="104"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    TabIndex="4"
                    Click="btnSimpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
