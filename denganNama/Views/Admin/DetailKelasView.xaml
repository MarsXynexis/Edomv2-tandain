<Page x:Class="DetailKelasView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Detail Kelas"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="{StaticResource BodyFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnKembali"
                    Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="btnKembali_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 15,18 L 9,12 L 15,6"
                          Stroke="{StaticResource InkPrimaryBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="12"
                          Height="12"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="Kembali ke Kelas" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                <TextBlock x:Name="txtProdiHeader" Text="-" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="{StaticResource SubtleBgBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">
                <TextBlock x:Name="txtRingkasanKelas" Text="0 mahasiswa · 0 pengampu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkPrimaryBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabMahasiswa"
                        Content="Anggota Mahasiswa"
                        Style="{StaticResource NavTabButtonStyle}"
                        Tag="Active"
                        Click="btnTabMahasiswa_Click"/>

                <Button x:Name="btnTabPengampu"
                        Content="Pengampu &amp; Mata Kuliah"
                        Style="{StaticResource NavTabButtonStyle}"
                        Click="btnTabPengampu_Click"/>
            </StackPanel>
        </Border>

        <Grid x:Name="panelMahasiswa" Grid.Row="2" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource InputFrameBorderStyle}" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="M 11,4 C 7.13,4 4,7.13 4,11 C 4,14.87 7.13,18 11,18 C 12.66,18 14.18,17.42 15.38,16.45 L 20,21 L 21.4,19.6 L 16.8,15 C 17.56,13.85 18,12.48 18,11 C 18,7.13 14.87,4 11,4 Z M 11,6 C 13.76,6 16,8.24 16,11 C 16,13.76 13.76,16 11,16 C 8.24,16 6,13.76 6,11 C 6,8.24 8.24,6 11,6 Z"
                              Fill="{StaticResource InkSecondaryBrush}"
                              Width="15"
                              Height="15"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                        <Grid Grid.Column="1">
                            <TextBlock x:Name="lblPlaceholderCariMhs"
                                       Text="Cari NIM atau nama mahasiswa di kelas ini..."
                                       Foreground="{StaticResource InkSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="2,0,12,0"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="txtCariMhs"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="2,0,12,0"
                                     FontSize="13"
                                     Foreground="{StaticResource InkPrimaryBrush}"
                                     TextChanged="txtCariMhs_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnTambahMhs"
                            Content="Tambah Mahasiswa"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="btnTambahMhs_Click"/>

                    <Button x:Name="btnEditMhs"
                            Content="Edit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnEditMhs_Click"/>

                    <Button x:Name="btnResetSandiMhs"
                            Content="Reset Sandi"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnResetSandiMhs_Click"/>

                    <Button x:Name="btnKeluarkanMhs"
                            Content="Keluarkan"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            Margin="8,0,0,0"
                            Click="btnKeluarkanMhs_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource SurfaceBgBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="dgMahasiswaKelas" Style="{StaticResource CleanDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIM" Binding="{Binding username}" Width="1.2*" ElementStyle="{StaticResource TabularNumericPrimaryStyle}"/>

                            <DataGridTextColumn Header="Nama Lengkap" Binding="{Binding nama}" Width="2.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding status_color}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding status_label}" Foreground="{Binding status_color}" FontWeight="SemiBold" FontSize="12.5"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtKosongMhs"
                               Text="Belum ada mahasiswa yang tergabung di kelas ini."
                               Foreground="{StaticResource InkSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <TextBlock x:Name="txtFooterMhs"
                       Grid.Row="2"
                       Text=""
                       FontSize="12"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       Margin="2,10,0,0"/>
        </Grid>

        <Grid x:Name="panelPengampu" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SubtleBgBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mata Kuliah" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbMatkul"
                                  Style="{StaticResource CleanComboBoxStyle}"
                                  DisplayMemberPath="Teks"/>
                    </StackPanel>

                    <Button x:Name="btnTambahMatkul"
                            Grid.Column="1"
                            Content="+ Mata Kuliah"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Margin="6,0,0,0"
                            ToolTip="Daftarkan mata kuliah baru"
                            Click="btnTambahMatkul_Click"/>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Dosen Pengampu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbDosen"
                                  Style="{StaticResource CleanComboBoxStyle}"
                                  DisplayMemberPath="Teks"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Periode Semester" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbPeriodeInput"
                                  Style="{StaticResource CleanComboBoxStyle}"
                                  DisplayMemberPath="Teks"/>
                    </StackPanel>

                    <Button x:Name="btnSimpanPengampu"
                            Grid.Column="7"
                            Content="Tetapkan Pengampu"
                            Style="{StaticResource PrimaryButtonStyle}"
                            VerticalAlignment="Bottom"
                            Click="btnSimpanPengampu_Click"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter Periode:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbFilterPeriode"
                              Style="{StaticResource CleanComboBoxStyle}"
                              Width="200"
                              Height="36"
                              SelectionChanged="cmbFilterPeriode_SelectionChanged"/>
                </StackPanel>

                <Button x:Name="btnHapusPengampu"
                        DockPanel.Dock="Right"
                        Content="Hapus Penugasan"
                        Style="{StaticResource DangerOutlineButtonStyle}"
                        Height="34"
                        Click="btnHapusPengampu_Click"/>
            </DockPanel>

            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBgBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="dgPengampuKelas" Style="{StaticResource CleanDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kode" Binding="{Binding kode_matkul}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="{StaticResource NumericFontFamily}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Mata Kuliah" Binding="{Binding nama_matkul}" Width="1.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource InkPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="SKS" Binding="{Binding sks}" Width="60" ElementStyle="{StaticResource TabularNumericSecondaryStyle}"/>

                            <DataGridTextColumn Header="Dosen Pengampu" Binding="{Binding nama_dosen}" Width="1.8*"/>

                            <DataGridTextColumn Header="Periode" Binding="{Binding nama_periode}" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="txtKosongPengampu"
                               Text="Belum ada penugasan dosen pengampu pada kelas ini."
                               Foreground="{StaticResource InkSecondaryBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <TextBlock x:Name="txtFooterPengampu"
                       Grid.Row="3"
                       Text=""
                       FontSize="12"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       Margin="2,10,0,0"/>
        </Grid>
    </Grid>
</Page>
