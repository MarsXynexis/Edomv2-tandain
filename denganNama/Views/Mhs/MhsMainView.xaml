<Page x:Class="MhsMainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Menu Mahasiswa"
      Background="White"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Dashboard Mahasiswa"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0, 0, 0, 8"/>

            <TextBlock Text="Selamat Datang di halaman pengisian Edom TandaIn"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0, 0, 0, 25"/>

            <TextBlock Text="Pilih Tahun Akademik"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="10,0,0,5" Width="150"/>
            <ComboBox
                       x:Name="cmbTahunAkademik"
                       Width="250px"
                       Height="35"
                       FontSize="14"
                       Margin="10"
                       SelectedIndex="0">          

                <ComboBoxItem Content="2025/2026 Genap"/>
                <ComboBoxItem Content="2026/2027 Ganjil"/>
                <ComboBoxItem Content="2026/2027 Ganjil"/>

            </ComboBox>

            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Border Background="#EEF2FF"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Total Mata Kuliah"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtTotalMataKuliah"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"/>
                        
                    </StackPanel>
                </Border>

                <Border Background="#F0FDF4"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Sudah dievaluasi"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtTotalEvaluasi"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF7ED"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Belum Terisi"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtBelumTerisi"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#EA580C"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel>
                    
                    <TextBlock Text="Informasi"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Silahkan mengisi evaluasi untuk mata kuliah yang belum dievaluasi sesuai dengan jadwal yang telah ditentukan."
                               TextWrapping="Wrap"
                               Foreground="#64748B"
                               FontSize="13"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
