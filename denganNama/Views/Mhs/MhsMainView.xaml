<Page x:Class="MhsMainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Menu Mahasiswa"
      Background="White"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="#FFFFFF"
                CornerRadius="12"
                Padding="22"
                Margin="0,20,0,30">

                <StackPanel>
                    <TextBlock Text="Pilih Tahun Akademik"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#0F172A"
                        Margin="10,0,0,5" Width="150"
                        HorizontalAlignment="Left"/>
                    <ComboBox
                            x:Name="cmbTahunAkademik"
                            Width="250"
                            Height="35"
                            FontSize="14"
                            Margin="10"
                            SelectedIndex="0"
                            HorizontalAlignment="Left">

                        <ComboBoxItem Content="2025/2026 Genap"/>
                        <ComboBoxItem Content="2026/2027 Ganjil"/>
                        <ComboBoxItem Content="2026/2027 Genap"/>

                    </ComboBox>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding DaftarMatkulMhs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Margin="0,0,0,20"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EEF2FF"
        CornerRadius="12"
        Padding="22"
        Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Total Mata Kuliah"
                   Foreground="#64748B"
                   FontSize="13"/>
                                <TextBlock x:Name="txtTotalMataKuliah"
                   Text="0"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="#4F46E5"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            

            <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,20,0,30">
                <StackPanel>

                            <TextBlock Text="Informasi"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Margin="0,0,0,10"/>

                            <TextBlock Text="Silahkan mengisi evaluasi untuk mata kuliah yang belum dievaluasi sesuai dengan jadwal yang telah ditentukan."
                                TextWrapping="Wrap"
                                Foreground="#64748B"
                                FontSize="13"/>
                    
                            
                </StackPanel>
            </Border>

            <Border
                CornerRadius="12"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,10">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                        <Setter Property="Background" Value="#DFE7E3"/>
                        <Style.Triggers>

                            <DataTrigger
                                Binding="{Binding IsCurrent}" 
                                Value="True">
                                <Setter Property="BorderBrush" Value="#4F46E5"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="1"
                            Text="→"
                            FontSize="21"
                            Foreground="#087653">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsCurrent}" 
                                            Value="True">
                                            <Setter Property="Visibility" 
                                                    Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Informasi}"
                               FontSize="11"
                               Foreground="#71817D"
                               Margin="0,9,0,0"/>

                    <Grid Grid.Row="2"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding Dosen}"
                            FontSize="10"
                            Foreground="#71817D"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Status}"
                            FontSize="10"
                            VerticalAlignment="Center">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter Property="Foreground" Value="#87918E"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding Status}"
                                            Value="Selesai">

                                            <Setter Property="Foreground"
                                                    Value="#087653"/>
                                        </DataTrigger>

                                        <DataTrigger
                                            Binding="{Binding Status}"
                                            Value="Sedang diisi">

                                            <Setter Property="Foreground"
                                                    Value="#087653"/>
                                        </DataTrigger>
                                        
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                    </Grid>
                </Grid>
            </Border>
                
            

        </StackPanel>
    </ScrollViewer>
</Page>
