<Page
    x:Class="MhsMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Menu Mahasiswa"
    Background="White"
    FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,14"
            Padding="16,12"
            Background="{StaticResource SubtleBgBrush}"
            BorderBrush="{StaticResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource InkPrimaryBrush}"
                    Text="Data Periode Semester" />
                <ComboBox
                    x:Name="cmbPeriodeSemester"
                    Grid.Column="1"
                    Selected="cmbPeriodeSemester_Selected"
                    Style="{StaticResource CleanComboBoxStyle}" />

                <Button
                    x:Name="btnTampilkan"
                    Grid.Column="4"
                    Margin="16,0,0,0"
                    Click="btnTampilkan_Click"
                    Content="Tampilkan"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox
                Grid.Column="0"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                FontWeight="SemiBold"
                Foreground="{StaticResource InkPrimaryBrush}"
                Header="Capaian 4 Pilar Kompetensi (Skala 0 - 100)" />
        </Grid>
    </Grid>
</Page>
