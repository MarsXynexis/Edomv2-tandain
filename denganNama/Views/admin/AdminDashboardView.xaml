<Page x:Class="AdminDashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Admin Dashboard"
      Background="White"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="Dashboard Admin"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Selamat datang di halaman administrasi TANDAIN."
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,0,0,25"/>

            <UniformGrid Columns="2" Margin="0,0,0,20">

                <Border Background="#EEF2FF"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="Total Mahasiswa"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtTotalMahasiswa"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"/>
                    </StackPanel>
                </Border>

                <Border Background="#ECFEFF"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Total Dosen"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtTotalDosen"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#0891B2"/>
                    </StackPanel>
                </Border>

                <Border Background="#F0FDF4"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Kelas"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtTotalKelas"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF7ED"
                        CornerRadius="12"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="Pengisian Kuesioner"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                        <TextBlock x:Name="txtPersentase"
                                   Text="0%"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#EA580C"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <Border Background="#F8FAFC"
                    CornerRadius="12"
                    Padding="22">
                <StackPanel>
                    <TextBlock Text="Informasi Administrasi"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Gunakan menu navigasi untuk mengelola pengguna, kelas, kuesioner, periode akademik, dan laporan evaluasi dosen."
                               TextWrapping="Wrap"
                               Foreground="#64748B"
                               FontSize="13"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
