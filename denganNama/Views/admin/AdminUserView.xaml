<Page x:Class="AdminUserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Kelola Pengguna"
      Background="#FFFFFF"
      FontFamily="Segoe UI"
      d:DesignHeight="600"
      d:DesignWidth="1000">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================= -->
        <!-- HEADER -->
        <!-- ================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock Text="Kelola Pengguna"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Kelola akun mahasiswa, dosen, dan admin."
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- ================================= -->
        <!-- SEARCH, FILTER DAN BUTTON -->
        <!-- ================================= -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>


            <!-- SEARCH -->

            <TextBox x:Name="txtCari"
                     Grid.Column="0"
                     Height="40"
                     Padding="12,8"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="#F8FAFC"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     ToolTip="Cari username atau nama pengguna"
                     TextChanged="txtCari_TextChanged"/>


            <!-- FILTER ROLE -->

            <ComboBox x:Name="cmbFilterRole"
                      Grid.Column="2"
                      Height="40"
                      Padding="8"
                      FontSize="13"
                      VerticalContentAlignment="Center"
                      Background="White"
                      BorderBrush="#CBD5E1"
                      BorderThickness="1"
                      SelectionChanged="cmbFilterRole_SelectionChanged">

                <ComboBoxItem Content="Semua Role"
                              IsSelected="True"/>

                <ComboBoxItem Content="mahasiswa"/>

                <ComboBoxItem Content="dosen"/>

                <ComboBoxItem Content="admin"/>

            </ComboBox>


            <!-- TAMBAH -->

            <Button x:Name="btnTambah"
                    Grid.Column="4"
                    Content="+ Tambah"
                    Height="40"
                    Background="#4F46E5"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnTambah_Click">


                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="7"/>
                    </Style>
                </Button.Resources>

            </Button>


            <!-- EDIT -->

            <Button x:Name="btnEdit"
                    Grid.Column="6"
                    Content="Edit"
                    Height="40"
                    Background="#0F172A"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnEdit_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="7"/>
                    </Style>
                </Button.Resources>

            </Button>


            <!-- NONAKTIFKAN -->

            <Button x:Name="btnHapus"
                    Grid.Column="8"
                    Content="Nonaktifkan"
                    Height="40"
                    Background="#DC2626"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnHapus_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="7"/>
                    </Style>
                </Button.Resources>

            </Button>

        </Grid>


        <!-- ================================= -->
        <!-- DATA GRID -->
        <!-- ================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">

            <DataGrid x:Name="dgUser"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="48"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      Background="White"
                      Foreground="#334155"
                      FontSize="13"
                      AlternatingRowBackground="#F8FAFC"
                      HorizontalGridLinesBrush="#E2E8F0"
                      VerticalGridLinesBrush="Transparent"
                      CanUserResizeRows="False">


                <!-- HEADER STYLE -->

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#F1F5F9"/>

                        <Setter Property="Foreground"
                                Value="#475569"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="FontSize"
                                Value="12"/>

                        <Setter Property="Height"
                                Value="42"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>

                        <Setter Property="BorderBrush"
                                Value="#E2E8F0"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <!-- ROW STYLE -->

                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="White"/>

                        <Setter Property="Foreground"
                                Value="#334155"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>

                        <Setter Property="BorderBrush"
                                Value="#F1F5F9"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#EEF2FF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#E0E7FF"/>

                                <Setter Property="Foreground"
                                        Value="#312E81"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.RowStyle>


                <!-- COLUMNS -->

                <DataGrid.Columns>


                    <!-- ID -->

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding id}"
                                        Width="60"/>


                    <!-- USERNAME -->

                    <DataGridTextColumn Header="Username / NIM / NIP"
                                        Binding="{Binding username}"
                                        Width="1.5*"/>


                    <!-- NAMA -->

                    <DataGridTextColumn Header="Nama Lengkap"
                                        Binding="{Binding nama}"
                                        Width="2*"/>


                    <!-- ROLE -->

                    <DataGridTextColumn Header="Role"
                                        Binding="{Binding role}"
                                        Width="120"/>


                    <!-- STATUS -->

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding aktif}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Page>
