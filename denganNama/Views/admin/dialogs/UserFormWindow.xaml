<Window x:Class="UserFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Pengguna"
        Height="570"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="25">
        <Border Background="White"
                CornerRadius="14"
                Padding="25">

            <StackPanel>

                <TextBlock x:Name="txtJudulForm"
                           Text="Tambah Pengguna"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Masukkan informasi pengguna"
                           Foreground="#64748B"
                           FontSize="13"
                           Margin="0,0,0,20"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtUsername"
                         Height="38"
                         Padding="10"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Nama -->
                <TextBlock Text="Nama Lengkap"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="txtNama"
                         Height="38"
                         Padding="10"
                         FontSize="13"
                         Margin="0,0,0,15"/>

                <!-- Role -->
                <TextBlock Text="Role Pengguna"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <ComboBox x:Name="cmbRole"
                          Height="38"
                          Padding="8"
                          FontSize="13"
                          Margin="0,0,0,15">

                    <ComboBoxItem Content="mahasiswa"/>
                    <ComboBoxItem Content="dosen"/>
                    <ComboBoxItem Content="admin"/>

                </ComboBox>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <PasswordBox x:Name="txtPassword"
                             Height="38"
                             Padding="10"
                             FontSize="13"
                             Margin="0,0,0,5"/>

                <TextBlock Text="Kosongkan password saat edit jika tidak ingin mengubahnya."
                           FontSize="11"
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Tombol -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnBatal"
                            Content="Batal"
                            Height="42"
                            Background="#E2E8F0"
                            Foreground="#0F172A"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="btnBatal_Click"/>

                    <Button x:Name="btnSimpan"
                            Grid.Column="2"
                            Content="Simpan"
                            Height="42"
                            Background="#4F46E5"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="btnSimpan_Click"/>

                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
