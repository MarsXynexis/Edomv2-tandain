
<Window x:Class="KelasFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form Kelas"
        Height="480"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock x:Name="txtJudulForm"
                       Text="Tambah Kelas"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>

            <TextBlock Text="Masukkan informasi kelas mahasiswa."
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- FORM INPUT -->

        <StackPanel Grid.Row="1">


            <!-- PROGRAM STUDI -->

            <TextBlock Text="Program Studi"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="txtProdi"
                     Height="42"
                     Padding="12,8"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     ToolTip="Masukkan nama program studi"/>


            <!-- ANGKATAN -->

            <TextBlock Text="Angkatan"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,20,0,8"/>

            <TextBox x:Name="txtAngkatan"
                     Height="42"
                     Padding="12,8"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     MaxLength="4"
                     ToolTip="Contoh: 2025"/>


            <!-- ROMBEL -->

            <TextBlock Text="Rombongan Belajar (Rombel)"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#334155"
                       Margin="0,20,0,8"/>

            <TextBox x:Name="txtRombel"
                     Height="42"
                     Padding="12,8"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     ToolTip="Contoh: A, B, atau C"/>


            <!-- STATUS -->

            <CheckBox x:Name="chkAktif"
                      Content="Aktif"
                      IsChecked="True"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Foreground="#334155"
                      Margin="0,20,0,0"/>

        </StackPanel>


        <!-- BUTTON -->

        <Grid Grid.Row="2"
              Margin="0,25,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>


            <!-- BATAL -->

            <Button x:Name="btnBatal"
                    Grid.Column="2"
                    Content="Batal"
                    Height="42"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnBatal_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="7"/>
                    </Style>
                </Button.Resources>

            </Button>


            <!-- SIMPAN -->

            <Button x:Name="btnSimpan"
                    Grid.Column="4"
                    Content="Simpan"
                    Height="42"
                    Background="#4F46E5"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btnSimpan_Click">

                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius"
                                Value="7"/>
                    </Style>
                </Button.Resources>

            </Button>

        </Grid>

    </Grid>

</Window>
