<Page x:Class="AccountMainView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Akun Saya"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch">
            <Border Background="{StaticResource SubtleBgBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            CornerRadius="6"
                            Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="lblInisial"
                                   Text="-"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkOnDarkBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="lblNama"
                                   Text="-"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}"/>
                        <TextBlock x:Name="lblSubIdentitas"
                                   Text="-"
                                   FontSize="13"
                                   Foreground="{StaticResource InkSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBgBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="Profil Akun"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                            <Grid>
                                <TextBlock x:Name="lblJudulId" Text="NIM / NIP" Foreground="{StaticResource InkSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblUsername" Text="-" Foreground="{StaticResource InkPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                            <Grid>
                                <TextBlock Text="Nama Lengkap" Foreground="{StaticResource InkSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblNamaLengkap" Text="-" Foreground="{StaticResource InkPrimaryBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,11">
                            <Grid>
                                <TextBlock Text="Peran" Foreground="{StaticResource InkSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblRole" Text="-" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="0,11,0,2">
                            <Grid>
                                <TextBlock x:Name="lblJudulUnit" Text="Jurusan" Foreground="{StaticResource InkSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblUnit" Text="-" Foreground="{StaticResource InkPrimaryBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{StaticResource SubtleBgBrush}"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="22,18"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Kata Sandi"
                                   FontSize="14.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkPrimaryBrush}"/>

                        <TextBlock Text="Kata sandi disimpan dalam bentuk terenkripsi. Kalau sandi barusan direset admin, langsung ganti di sini supaya akunmu tetap aman."
                                   FontSize="12.5"
                                   Foreground="{StaticResource InkSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,18"/>

                        <Button x:Name="btnGantiPassword"
                                Content="Ganti Kata Sandi"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="btnGantiPassword_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
