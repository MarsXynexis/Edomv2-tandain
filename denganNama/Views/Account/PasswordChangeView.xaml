<Page x:Class="PasswordChangeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ganti Kata Sandi"
      Background="{StaticResource SurfaceBgBrush}"
      FontFamily="{StaticResource BodyFontFamily}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Text="Pakai minimal 6 karakter dan usahakan berbeda dari kata sandi yang lama."
                       FontSize="13"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource SubtleBgBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Kata Sandi Sekarang" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                        <PasswordBox x:Name="txtPassLama"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource InkPrimaryBrush}"
                                     TabIndex="0"/>
                    </Border>

                    <TextBlock Text="Kata Sandi Baru" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                        <PasswordBox x:Name="txtPassBaru"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource InkPrimaryBrush}"
                                     TabIndex="1"/>
                    </Border>

                    <TextBlock Text="Ulangi Kata Sandi Baru" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource InkPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,22">
                        <PasswordBox x:Name="txtKonfirmasi"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="12,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource InkPrimaryBrush}"
                                     TabIndex="2"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSimpan"
                                Content="Simpan"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                TabIndex="3"
                                Click="btnSimpan_Click"/>

                        <Button x:Name="btnBatal"
                                Content="Batal"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0"
                                TabIndex="4"
                                Click="btnBatal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
