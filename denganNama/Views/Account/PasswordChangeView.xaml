<Page x:Class="PasswordChangeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ganti Password"
      Background="White" FontFamily="Segoe UI">

    <StackPanel MaxWidth="500" HorizontalAlignment="Left">
        <!-- Header Halaman -->
        <TextBlock Text="Perbarui Kata Sandi" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Text="Gunakan kombinasi minimal 6 karakter agar kata sandi Anda kuat." FontSize="13" Foreground="#64748B" Margin="0,4,0,24"/>

        <Border BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="16" Padding="28" Background="#F8FAFC">
            <StackPanel>
                <!-- Input Password Lama -->
                <TextBlock Text="Kata Sandi Lama" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Margin="0,0,0,16">
                    <PasswordBox x:Name="txtPassLama" Height="38" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- Input Password Baru -->
                <TextBlock Text="Kata Sandi Baru" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Margin="0,0,0,16">
                    <PasswordBox x:Name="txtPassBaru" Height="38" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- Input Konfirmasi -->
                <TextBlock Text="Konfirmasi Kata Sandi Baru" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Margin="0,0,0,24">
                    <PasswordBox x:Name="txtKonfirmasi" Height="38" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center"/>
                </Border>

                <!-- Tombol Simpan & Batal -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSimpan" Height="40" Padding="20,0" Foreground="White" 
                            FontWeight="Bold" FontSize="13" Cursor="Hand" Click="btnSimpan_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#16A34A">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓ Simpan Perubahan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnBatal" Content="Batal" Height="40" Padding="20,0" Margin="10,0,0,0"
                            Background="White" BorderBrush="#CBD5E1" BorderThickness="1.2" Foreground="#475569" 
                            FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="btnBatal_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>