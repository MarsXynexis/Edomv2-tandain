<Window x:Class="LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masuk - EDOM TIK"
        Icon="/assets/img/edom-icon.png"
        Height="500"
        Width="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{StaticResource BodyFontFamily}"
        Background="{StaticResource SurfaceBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="435"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="16,16,0,16"
                CornerRadius="16">
            <Border.Background>
                <ImageBrush ImageSource="/assets/img/edom-login-art.jpg"
                            Stretch="UniformToFill"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border.Background>

            <Path Data="M 62,0 C 4,115 92,235 34,355 C -2,430 46,478 72,500 L 105,500 L 105,0 Z"
                  Fill="{StaticResource SurfaceBgBrush}"
                  Stretch="Fill"
                  HorizontalAlignment="Right"
                  Width="78"
                  Margin="0,-1,-2,-1"/>
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="26,0,44,0"
                    VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,22">
                <Image Source="/assets/img/edom-icon.png"
                       Width="54"
                       Height="54"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="EDOM TIK"
                               FontFamily="{StaticResource DisplayFontFamily}"
                               FontSize="16.5"
                               FontWeight="Bold"
                               Foreground="{StaticResource InkPrimaryBrush}"/>
                    <TextBlock Text="Politeknik Negeri Jakarta"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Masuk Akun"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="{StaticResource InkPrimaryBrush}"/>
            <TextBlock Text="Sistem Evaluasi Dosen Oleh Mahasiswa"
                       FontSize="13"
                       Foreground="{StaticResource InkSecondaryBrush}"
                       Margin="0,4,0,20"/>

            <TextBlock Text="NIM / NIP / Username"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,14">
                <TextBox x:Name="txtUsername"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Padding="12,0"
                         FontSize="13"
                         Foreground="{StaticResource InkPrimaryBrush}"
                         TabIndex="0"/>
            </Border>

            <TextBlock Text="Kata Sandi"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkPrimaryBrush}"
                       Margin="0,0,0,6"/>
            <Border Style="{StaticResource InputFrameBorderStyle}" Margin="0,0,0,22">
                <PasswordBox x:Name="txtPassword"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="12,0"
                             FontSize="13"
                             Foreground="{StaticResource InkPrimaryBrush}"
                             TabIndex="1"/>
            </Border>

            <Button x:Name="btnLogin"
                    Content="Masuk"
                    Height="42"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    TabIndex="2"
                    Click="btnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>
