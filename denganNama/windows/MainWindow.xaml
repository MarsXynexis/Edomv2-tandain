<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TANDAIN - Sistem Evaluasi Akademik" Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Background="#F1F5F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <!-- 1. Header Atas -->
            <RowDefinition Height="56"/>
            <!-- 2. Navbar Horizontal -->
            <RowDefinition Height="*"/>
            <!-- 3. Main Konten Area -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER ATAS (Kiri: TANDAIN, Kanan: Gibran, Tengah Bersih) -->
        <Border Grid.Row="0" Background="#0F172A" Padding="32,0">
            <Grid VerticalAlignment="Center">
                <!-- Sisi Kiri: Brand & Logo TANDAIN -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#06B6D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="📌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TANDAIN" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Portal Evaluasi Akademik" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Sisi Kanan: Profil Pengguna Gibran -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="22" Padding="12,5" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="txtNamaUser" Text="Gibran" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Mahasiswa" Foreground="#38BDF8" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. NAVBAR HORIZONTAL -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="28,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Tombol Logout -->
                <Button DockPanel.Dock="Right" Padding="14,6" Background="#FEF2F2" BorderBrush="#FECACA" 
                        BorderThickness="1" Cursor="Hand" Click="BtnLogout_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚪" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Keluar" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tab Menu Navigasi -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnMenuDashboard" Content="📊 Dashboard" Padding="16,8" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" 
                            Foreground="#64748B" Cursor="Hand"/>

                    <Button x:Name="btnMenuKuesioner" Content="📝 Kuesioner" Padding="16,8" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" FontWeight="SemiBold" FontSize="13" 
                            Foreground="#64748B" Cursor="Hand"/>

                    <!-- Tab Akun Saya (Aktif) -->
                    <Border CornerRadius="9" Margin="0,0,6,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F46E5" Offset="0.0"/>
                                <GradientStop Color="#3B82F6" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Button x:Name="btnMenuAkun" Content="👤 Akun Saya" Padding="16,8"
                                Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="13" 
                                Foreground="White" Cursor="Hand" Click="BtnMenuAkun_Click"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. MAIN KONTEN DI TENGAH (KARTU PUTIH MELAYANG) -->
        <Border Grid.Row="2" Margin="30,22,30,25" Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1" Padding="35">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#0F172A" Opacity="0.05" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Baris Tahun Ajaran di Bawah Navbar -->
                    <RowDefinition Height="*"/>
                    <!-- Wadah Konten Page -->
                </Grid.RowDefinitions>

                <!-- BARIS TAHUN AJARAN DI BAWAH NAVBAR -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,22">
                    <Grid>
                        <!-- Kiri: Judul Halaman -->
                        <TextBlock x:Name="txtJudulHalaman" Text="Pengaturan Akun Pengguna" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

                        <!-- Kanan: Info Periode Aktif -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tahun Ajaran 2026/2027 Ganjil (Periode Aktif)" Foreground="#475569" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Frame Tempat Halaman Akun Ditampilkan -->
                <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Border>
    </Grid>
</Window>