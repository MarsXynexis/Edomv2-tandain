<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDOM TIK - Sistem Evaluasi Dosen Oleh Mahasiswa"
        Icon="/assets/img/edom-icon.png"
        Height="760"
        Width="1220"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource CanvasBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="24,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="/assets/img/edom-icon.png"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0"/>

                    <TextBlock Text="EDOM TIK" Foreground="{StaticResource InkOnDarkBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{StaticResource HeaderBorderBrush}" Margin="12,0"/>
                    <TextBlock Text="Sistem Evaluasi Dosen Oleh Mahasiswa" Foreground="{StaticResource InkOnDarkMutedBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                        <TextBlock x:Name="txtNamaUser" Text="-" Foreground="{StaticResource InkOnDarkBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="txtRoleUser" Text="-" Foreground="{StaticResource InkOnDarkMutedBrush}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button x:Name="btnLogout"
                            Content="Keluar"
                            Style="{StaticResource HeaderLogoutButtonStyle}"
                            Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="panelNavMahasiswa" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="btnMhsDashboard" Content="Daftar Mata Kuliah" Style="{StaticResource NavTabButtonStyle}" Click="BtnMhsDashboard_Click"/>
                        <Button x:Name="btnMhsQuestion" Content="Kuesioner" Style="{StaticResource NavTabButtonStyle}" Click="BtnMhsQuestion_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="panelNavDosen" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="btnDosenMain" Content="Capaian Evaluasi" Style="{StaticResource NavTabButtonStyle}" Click="BtnDosenMain_Click"/>
                        <Button x:Name="btnDosenDetail" Content="Rincian Kelas" Style="{StaticResource NavTabButtonStyle}" Click="BtnDosenDetail_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="panelNavAdmin" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="btnAdminRekap" Content="Rekapitulasi" Style="{StaticResource NavTabButtonStyle}" Click="BtnAdminRekap_Click"/>
                        <Button x:Name="btnAdminSetup" Content="Setup EDOM" Style="{StaticResource NavTabButtonStyle}" Click="BtnAdminSetup_Click"/>
                        <Button x:Name="btnAdminKelas" Content="Daftar Kelas" Style="{StaticResource NavTabButtonStyle}" Click="BtnAdminKelas_Click"/>
                        <Button x:Name="btnAdminDosen" Content="Daftar Dosen" Style="{StaticResource NavTabButtonStyle}" Click="BtnAdminDosen_Click"/>
                        <Button x:Name="btnAdminMahasiswa" Content="Daftar Mahasiswa" Style="{StaticResource NavTabButtonStyle}" Click="BtnAdminMahasiswa_Click"/>
                    </StackPanel>

                    <Button x:Name="btnMenuAkun" Content="Akun Saya" Style="{StaticResource NavTabButtonStyle}" Click="BtnMenuAkun_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse x:Name="indikatorPeriode" Width="8" Height="8" Fill="{StaticResource StatusClosedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPeriodeAktif" Text="Periode: -" Foreground="{StaticResource InkSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="{StaticResource CanvasBgBrush}">
            <Border Margin="20,16" Background="{StaticResource SurfaceBgBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,18">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="txtJudulHalaman" DockPanel.Dock="Left" Text="Akun Saya" FontSize="17" FontWeight="Bold" Foreground="{StaticResource InkPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSubJudulHalaman" DockPanel.Dock="Right" Text="Informasi profil pengguna" FontSize="12.5" Foreground="{StaticResource InkSecondaryBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
